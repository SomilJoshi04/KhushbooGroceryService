
# ── Server Configuration ──────────────────────────────────────────────────────
# Application environment: development | test | staging | production
NODE_ENV=development
# Port Express listens on locally
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
MONGO_URI=Your_mongo_url

# ── CORS & Client ─────────────────────────────────────────────────────────────
# Frontend origin allowed to communicate with this API with credentials
CLIENT_URL=http://localhost:5173

# ── Authentication & Security ─────────────────────────────────────────────────
# Cryptographically random string (min 32 characters) for signing JWT auth tokens
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret_here
# JWT token validity period
JWT_EXPIRES_IN=7d

# ── Customer Phone OTP Configuration ──────────────────────────────────────────
# Time-to-live for OTP sessions in minutes
OTP_TTL_MINUTES=5
# Maximum failed verification attempts before locking OTP session
OTP_MAX_ATTEMPTS=5
# Minimum cooldown period in seconds before requesting another OTP
OTP_RESEND_COOLDOWN_SECONDS=45
# Number of digits for OTP verification (4 to 8, standard 4 or 6)
OTP_LENGTH=4
# Developer simulation mode (MUST be false in production)
USE_DEV_OTP=true
# Static OTP code used only when USE_DEV_OTP=true (dev/testing only)
DEV_OTP=1234

# ── Store Location & Delivery Zone (Indore, M.P.) ─────────────────────────────
STORE_CITY=
STORE_STATE=
STORE_PINCODE=
STORE_LAT=
STORE_LNG=
MAX_DELIVERY_DISTANCE_KM=
# Free delivery threshold in integer paise (₹499.00 = 49900 paise)
FREE_DELIVERY_THRESHOLD_PAISE=
# Minimum order amount in integer paise (₹150.00 = 15000 paise)
MIN_ORDER_AMOUNT_PAISE=
# Routing distance provider: mock | openrouteservice | google
ROUTING_PROVIDER=

# ── Administrator Credentials & Bootstrap (Required) ─────────────────────────
# Initial super administrator email address (required, normalized to lowercase)
ADMIN_EMAIL=
# Initial super administrator password (required, min 8 characters; >= 10 in production)
ADMIN_PASSWORD=
# Initial super administrator phone number in Indian format (e.g. +9198XXXXXXXX or 98XXXXXXXX)
ADMIN_PHONE=

# ── Online Payments (Phase 7 - Razorpay) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_signing_secret

# ── SMS Provider (Phase 10 - Optional external SMS Gateway) ───────────────────
# SMS_PROVIDER=fast2sms
# SMS_API_KEY=placeholder_sms_api_key
# SMS_SENDER_ID=KFOODS

# ── Maps, Geocoding & Routing (Optional Server-side credentials) ───────────────
# Default: leaflet / nominatim / mock distance (Zero external credentials required)
# If switching to Google Maps server-side APIs:
# GOOGLE_MAPS_SERVER_KEY=your_private_google_maps_backend_secret_key_here

# ── Local VPS File Storage (Zero Cloudinary) ──────────────────────────────────
# Storage provider: local (VPS filesystem)
STORAGE_PROVIDER=local
# Uploads root directory relative to backend (defaults to 'uploads')
UPLOAD_DIR=uploads
# Maximum allowed file size for image uploads in megabytes
MAX_IMAGE_SIZE_MB=5
# Maximum allowed file size for document uploads in megabytes
MAX_DOCUMENT_SIZE_MB=10
# Public base URL for asset resolution (leave empty to use relative /uploads/... paths)
PUBLIC_BASE_URL=



