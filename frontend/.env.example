# Khushboo Food Service — Frontend Environment Variables (Example)
# Copy this file to .env and fill in the correct value for your environment.
# This file IS committed to Git (contains no real secrets).
#
# ⚠️  Every VITE_ variable is embedded into the browser bundle at build time.
#     Treat all values as PUBLIC. Never put private credentials here.

# ── API ───────────────────────────────────────────────────────────────────────
# URL of the backend API. Must match the running backend.
#
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
#
# Staging example (set in your hosting provider's environment settings):
# VITE_API_BASE_URL=https://staging-api.yourdomain.com/api
#
# Production example (set in your hosting provider's environment settings):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
#
# IMPORTANT: Because Vite embeds VITE_ values at build time, you must set the
# correct value BEFORE running `npm run build`, or rebuild after changing it.
# The production build must never target http://localhost:*.

# ── Maps & Geocoding (Leaflet by default; Google Maps supported) ───────────────
# Default: leaflet (Nominatim OpenStreetMap - free, zero API key required)
VITE_MAP_PROVIDER=leaflet
# Optional: Set when switching to Google Maps. Use a PUBLIC, browser-restricted key ONLY.
# VITE_GOOGLE_MAPS_API_KEY=your_public_browser_restricted_google_maps_key_here

