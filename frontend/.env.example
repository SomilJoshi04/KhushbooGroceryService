# Khushboo Food Service — Frontend Environment Variables (Example)
# Copy this file to .env and fill in the correct value for your environment.
# This file IS committed to Git (contains no real secrets).
#
# ⚠️  Every VITE_ variable is embedded into the browser bundle at build time.
#     Treat all values as PUBLIC. Never put private credentials here.

# ── API ───────────────────────────────────────────────────────────────────────
# URL of the backend API. Must match the running backend.
#
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
#
# Staging example (set in your hosting provider's environment settings):
# VITE_API_BASE_URL=https://staging-api.yourdomain.com/api
#
# Production example (set in your hosting provider's environment settings):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
#
# IMPORTANT: Because Vite embeds VITE_ values at build time, you must set the
# correct value BEFORE running `npm run build`, or rebuild after changing it.
# The production build must never target http://localhost:*.

# ── Uploads Base URL ──────────────────────────────────────────────────────────
# Prefix for /uploads/... image URLs returned by the backend API.
#
# LOCAL (dev server):   Leave empty. Vite dev proxy handles /uploads → backend.
# PRODUCTION same-host: Leave empty if Nginx proxies /uploads to the backend.
# PRODUCTION diff-host: Set to backend's public base URL.
#                       Example: VITE_UPLOADS_BASE_URL=https://khushboogroceryservice.in
VITE_UPLOADS_BASE_URL=

# ── Maps & Geocoding (Google Maps Platform or Leaflet fallback) ───────────────
# Set to 'google' for production managed Google Maps Platform.
# Set to 'leaflet' for OpenStreetMap Nominatim development fallback.
VITE_MAP_PROVIDER=google

# Google Maps Platform Browser-Restricted API Key
# Required APIs in Google Cloud Console:
# 1. Maps JavaScript API (interactive map display & marker rendering)
# 2. Places API (place search, autocomplete, colony discovery)
# 3. Geocoding API (reverse geocoding pin drops & address extraction)
# ⚠️ SECURITY: Restrict this key in Google Cloud Console to your production HTTP referrers
# (e.g. https://khushboogroceryservice.in/* and http://localhost:5173/* for local dev).
VITE_GOOGLE_MAPS_API_KEY=your_public_browser_restricted_google_maps_key_here

# ── Browser Web Push (VAPID) ──────────────────────────────────────────────────
# Public VAPID key for web push subscriptions (embedded into client bundle)
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key_here

