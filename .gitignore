# ─────────────────────────────────────────────────────────────────────────────
# Khushboo Food Service — Monorepo Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Development Artifacts & Temporary Files ──────────────────────────────────
/development-files/
development-files/
scratch/
tmp/
temp/
*.tmp
*.temp
backend/uploads/*
!backend/uploads/.gitkeep


# ── Environment Variables (CRITICAL: NEVER COMMIT REAL SECRETS) ──────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# ── Markdown Files (Exclude internal guides/reports; preserve essentials) ─────
*.md
README.md
SECURITY.md
LICENSE*
frontend/README.md

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Production Build Artifacts ────────────────────────────────────────────────
dist/
build/
**/dist/
**/build/
dist-ssr/
*.local

# ── Debug Logs ────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test & Coverage Artifacts ─────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
junit.xml

# ── Runtime & Process IDs ─────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── OS & Editor Metadata ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
